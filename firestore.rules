rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Barbershops collection and all subcollections (appointments, publicAvailability, appointmentEvents)
    match /barbershops/{barbershopId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Root appointments collection (filtered by barbershopId)
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Devices registered for FCM push notifications
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // Notifications history
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Connections pairing
    match /connections/{connectionId} {
      allow read, write: if true;
    }

    // Fallback for any other test or system collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

